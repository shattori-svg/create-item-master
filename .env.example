# このファイルを .env にコピーし、下記の値を設定してください。

# Supabase（分類・仕入先マスタDB）
# Supabase Dashboard → Settings → API から取得
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 分類の GenAI（Gemini）推測用。未設定の場合はキーワード一致で推測します。
# サーバー側プロキシ（/api/ai-suggest）経由で使用するため、クライアントには露出しません。
# キー取得: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
# 使用モデル（未設定時は gemini-3.5-flash-lite）。モデル退役時はここだけ変更すればよい。
# 提供モデル一覧: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite

# Entra ID 認証（server.js）
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_TENANT_GUID=
ENTRA_REDIRECT_URI=http://localhost:8080/auth/callback
# Comma-separated list of allowed email domains (empty = allow any)
ENTRA_ALLOWED_DOMAIN=g.oic-sys.net,oic-g.com
SESSION_SECRET=

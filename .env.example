# このファイルを .env にコピーし、下記の値を設定してください。

# Cloud SQL for PostgreSQL（ユーザー／マスタ／操作ログ DB）
# 未設定でもサーバーは起動する（DB 系エンドポイントは 503、ユーザーは data/users.json）。
#
# ローカル開発 / Cloud SQL Auth Proxy 経由なら DATABASE_URL だけでよい。
DATABASE_URL=
#
# Cloud Run 本番は組込みの Cloud SQL 連携（--add-cloudsql-instances）を使い、
# ソケットパスと認証情報を個別に渡す。DB_PASS は Secret Manager から注入する。
# INSTANCE_UNIX_SOCKET=/cloudsql/<PROJECT>:<REGION>:<INSTANCE>
INSTANCE_UNIX_SOCKET=
DB_USER=
DB_PASS=
DB_NAME=
# プール上限（既定 5）。Cloud Run の --max-instances × この値 < max_connections にする。
DB_POOL_MAX=5
# TCP 接続（Private IP など）を使う場合のみ。DB_SSL=1 で TLS 必須にする。
# DB_HOST=
# DB_PORT=5432
# DB_SSL=
# DB_CA_CERT=

# 分類の GenAI（Gemini）推測用。未設定の場合はキーワード一致で推測します。
# サーバー側プロキシ（/api/ai-suggest）経由で使用するため、クライアントには露出しません。
# キー取得: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
# 使用モデル（未設定時は gemini-3.5-flash-lite）。モデル退役時はここだけ変更すればよい。
# 提供モデル一覧: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite

# Entra ID 認証（server.js）
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_TENANT_GUID=
ENTRA_REDIRECT_URI=http://localhost:8080/auth/callback
# Comma-separated list of allowed email domains (empty = allow any)
ENTRA_ALLOWED_DOMAIN=g.oic-sys.net,oic-g.com
SESSION_SECRET=
